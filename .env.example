# Aerospace-RCA Docker bundle — copy to .env and edit before `docker compose up`.
#
#   cp .env.example .env

# Signing key the engine uses to mint/verify its own tokens. ANY long
# random string; generate one and keep it stable for this deployment:
#   openssl rand -base64 32
AIDB_JWT_SECRET=change-me-to-a-long-random-string

# Admin password pinned on the engine. The app + bridge log in with this
# (username "admin") to obtain a token at startup. Change it before any
# non-local deployment.
AIDB_ADMIN_PASSWORD=change-me-too

# ── Optional ─────────────────────────────────────────────────────────
# Telemetry source: "mock" (in-browser simulator, default) or "cosmos"
# (OpenC3 COSMOS Streaming API — see apps/aerospace-rca/docs/REAL-TELEMETRY.md
# and apps/telemetry-bridge/cosmos/). For cosmos, also set COSMOS_WS_URL /
# COSMOS_TOKEN and overlay apps/telemetry-bridge/cosmos/docker-compose.cosmos.yml.
# BRIDGE_SOURCE=mock

# Aggregate write cadence (ms). 5000 is conservative; drop to 1000 for a
# higher-load demo if the engine box can absorb it.
# DCU_AGGREGATE_PERIOD_MS=5000
