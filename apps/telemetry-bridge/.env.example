# telemetry-bridge env

# Reuse the same SynapCores AIDB the aerospace-rca app talks to.
SYNAPCORES_URL=http://127.0.0.1:8081
SYNAPCORES_ADMIN_API_KEY=replace-me-with-a-real-jwt-or-api-key   # for local dev; the Docker bundle mints this automatically (see bin/aidb-login.mjs)

DCU_BRIDGE_PORT=4005
DCU_AGGREGATE_PERIOD_MS=5000
DCU_BATCH_ROWS=500
# Set to 0 to skip writing 1Hz / 0.2Hz aggregates (alerts + promoted
# anomalies still flow). Keep at 1 for the full demo.
DCU_PERSIST_AGGREGATES=1

# ── Telemetry source (Track C) ───────────────────────────────────────
# mock   = in-browser Web Worker simulator over /ingest (default)
# cosmos = also ingest from an OpenC3 COSMOS Streaming API
# See docs/REAL-TELEMETRY.md (in apps/aerospace-rca) + cosmos/README.md.
BRIDGE_SOURCE=mock
# Required when BRIDGE_SOURCE=cosmos:
# COSMOS_WS_URL=ws://localhost:2900/openc3-api/cable
# COSMOS_TOKEN=changeme            # COSMOS API password / service token
# COSMOS_SCOPE=DEFAULT
# COSMOS_ITEM_MAP=./config/cosmos-map.json
